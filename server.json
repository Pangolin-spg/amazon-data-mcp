{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Pangolin-spg/amazon-data-mcp",
  "title": "Pangolinfo Amazon Data MCP",
  "description": "Real-time Amazon commerce, WIPO design patent, trends, search, and local market data.",
  "version": "0.1.1",
  "websiteUrl": "https://www.pangolinfo.com/amazon-data-mcp/",
  "repository": {
    "url": "https://github.com/Pangolin-spg/amazon-data-mcp",
    "source": "github",
    "id": "1339111862"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.pangolinfo.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {pangolinfo_api_key}",
          "variables": {
            "pangolinfo_api_key": {
              "description": "Your Pangolinfo API key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pangolinfo-amazon-data-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PANGOLINFO_API_KEY",
          "description": "Your Pangolinfo API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
